{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "shalgalt-omr",
  "version": "0.1.0",
  "identifier": "dev.filename.shalgalt-omr.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../../build"
  },
  "app": {
    "windows": [
      {
        "title": "shalgalt-omr",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$APPCACHE/**", "$APPLOCALDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["shalgalt"],
        "description": "shalgalt-omr exam project",
        "role": "Editor",
        "mimeType": "application/vnd.shalgalt-omr+zip"
      }
    ],
    "resources": [
      "resources/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"]
      },
      "wix": {
        "language": "en-US"
      },
      "certificateThumbprint": null,
      "signCommand": null
    },
    "linux": {
      "deb": {
        "depends": ["libopencv-core4.5d | libopencv-core406 | libopencv-core4.6"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "signingIdentity": null,
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://filename24.github.io/shalgalt-omr/latest.json"],
      "pubkey": "TODO_TRACK_SCRIPTS_PUBKEY_PLACEHOLDER",
      "dangerousInsecureTransportProtocol": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
