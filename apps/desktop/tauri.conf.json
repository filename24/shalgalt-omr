{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "shalgalt-omr",
  "version": "0.6.0-rc.1",
  "identifier": "dev.filename.shalgalt-omr",
  "build": {
    "beforeDevCommand": "pnpm setup:binaries && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm setup:binaries && pnpm build",
    "frontendDist": "../../build"
  },
  "app": {
    "windows": [
      {
        "title": "shalgalt-omr",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPCACHE/**",
          "$APPLOCALDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "shalgalt"
        ],
        "description": "shalgalt-omr exam project",
        "role": "Editor",
        "mimeType": "application/vnd.shalgalt-omr+zip"
      }
    ],
    "resources": [
      "resources/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "English"
        ]
      },
      "wix": {
        "language": "en-US"
      },
      "certificateThumbprint": null,
      "signCommand": null
    },
    "linux": {
      "deb": {
        "depends": [
          "libopencv-core4.5d | libopencv-core406 | libopencv-core4.6",
          "libopencv-imgproc4.5d | libopencv-imgproc406 | libopencv-imgproc4.6",
          "libopencv-imgcodecs4.5d | libopencv-imgcodecs406 | libopencv-imgcodecs4.6",
          "libopencv-objdetect4.5d | libopencv-objdetect406 | libopencv-objdetect4.6",
          "libopencv-calib3d4.5d | libopencv-calib3d406 | libopencv-calib3d4.6",
          "libopencv-features2d4.5d | libopencv-features2d406 | libopencv-features2d4.6",
          "libopencv-flann4.5d | libopencv-flann406 | libopencv-flann4.6"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "signingIdentity": null,
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://filename24.github.io/shalgalt-omr/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwRjIzOUVDQ0U4MDI1MDEKUldRQkpZRE83RG55d0hOWnJCNFdlWnZRMU9kTk5RMUZTRjVROXBCdENaMDRTVFFGbTNxQ1FsSGMK",
      "dangerousInsecureTransportProtocol": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}