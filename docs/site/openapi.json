{
  "openapi": "3.1.0",
  "info": {
    "title": "shalgalt-omr HTTP API",
    "description": "Read/write access to exams, templates, and graded results. The desktop app exposes this read-only on 127.0.0.1; the standalone server exposes it read-write with bearer auth.",
    "contact": {
      "name": "filename24"
    },
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "meta"
        ],
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Service is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/exams": {
      "get": {
        "tags": [
          "exams"
        ],
        "operationId": "list_exams",
        "responses": {
          "200": {
            "description": "All exams",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExamDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "exams"
        ],
        "operationId": "create_exam",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewExam"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created exam",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExamDto"
                }
              }
            }
          },
          "400": {
            "description": "Read-only mode or invalid body"
          }
        }
      }
    },
    "/v1/exams/{id}": {
      "get": {
        "tags": [
          "exams"
        ],
        "operationId": "get_exam",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Exam id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The exam",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExamDto"
                }
              }
            }
          },
          "404": {
            "description": "No exam with that id"
          }
        }
      }
    },
    "/v1/results": {
      "get": {
        "tags": [
          "results"
        ],
        "operationId": "list_results",
        "parameters": [
          {
            "name": "exam_id",
            "in": "query",
            "description": "Filter by exam id",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Graded results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ResultDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "results"
        ],
        "operationId": "create_result",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewResult"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultDto"
                }
              }
            }
          },
          "400": {
            "description": "Read-only mode or invalid body"
          }
        }
      }
    },
    "/v1/templates": {
      "get": {
        "tags": [
          "templates"
        ],
        "operationId": "list_templates",
        "responses": {
          "200": {
            "description": "All templates (metadata only)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TemplateSummaryDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/templates/{id}": {
      "get": {
        "tags": [
          "templates"
        ],
        "operationId": "get_template",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Template id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Template with its serialized OmrTemplate",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplateDto"
                }
              }
            }
          },
          "404": {
            "description": "No template with that id"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ExamDto": {
        "type": "object",
        "description": "An exam: a named binding of an answer-key set to a template (`exams` table).",
        "required": [
          "id",
          "name",
          "template_id",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "description": "SQLite `CURRENT_TIMESTAMP` text (`YYYY-MM-DD HH:MM:SS`, UTC)."
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "template_id": {
            "type": "integer",
            "format": "int64"
          },
          "updated_at": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "description": "Health probe payload.",
        "required": [
          "ok",
          "version"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "NewExam": {
        "type": "object",
        "description": "Request body for `POST /v1/exams`.",
        "required": [
          "name",
          "template_id"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "template_id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "NewResult": {
        "type": "object",
        "description": "Request body for `POST /v1/results`.",
        "required": [
          "template_id",
          "total_score",
          "detail_answers"
        ],
        "properties": {
          "detail_answers": {
            "type": "string",
            "description": "Opaque JSON string mirroring [`ResultDto::detail_answers`]."
          },
          "exam_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "image_path": {
            "type": [
              "string",
              "null"
            ],
            "description": "Caller-controlled, untrusted opaque string. The API stores it verbatim and never\ntouches the filesystem with it; any consumer that turns it into a path (e.g. the\ndesktop loading it via `asset://`) MUST sanitize it against directory traversal\nfirst — it is not validated here."
          },
          "student_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "template_id": {
            "type": "integer",
            "format": "int64"
          },
          "total_score": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "ResultDto": {
        "type": "object",
        "description": "A graded result row (`results` table).\n\n`detail_answers` is opaque JSON (per-question correct/wrong/blank) carried as a string\nso the API stays agnostic to the grading engine's internal shape — the same posture as\n`templates.json_schema`.",
        "required": [
          "id",
          "template_id",
          "total_score",
          "detail_answers",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string"
          },
          "detail_answers": {
            "type": "string"
          },
          "exam_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "image_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "student_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "template_id": {
            "type": "integer",
            "format": "int64"
          },
          "total_score": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "TemplateDto": {
        "type": "object",
        "description": "A template with its full Rule 3 payload, returned by `GET /v1/templates/:id`.\n\n`json_schema` is the serialized `OmrTemplate` exactly as stored in\n`templates.json_schema` (TEXT). It is handed back verbatim rather than re-parsed so the\nAPI never reshapes the canonical template format — consumers parse it with the same\nschema the editor wrote.",
        "required": [
          "id",
          "title",
          "json_schema",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "json_schema": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "TemplateSummaryDto": {
        "type": "object",
        "description": "A template as it appears in `GET /v1/templates` listings — metadata only, without the\n(potentially large) serialized `OmrTemplate` body.",
        "required": [
          "id",
          "title",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "meta",
      "description": "Health and service metadata"
    },
    {
      "name": "exams",
      "description": "Exam definitions"
    },
    {
      "name": "templates",
      "description": "OMR templates"
    },
    {
      "name": "results",
      "description": "Graded results"
    }
  ]
}