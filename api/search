pe":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#options-considered-engine","content":"Higher-level layout, but layout engine fights us for vector primitives"},"107":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-33","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#options-considered-engine","content":"C. `lopdf` (raw)"},"108":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-34","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#options-considered-engine","content":"Yes"},"109":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-35","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#options-considered-engine","content":"Manual"},"110":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-36","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#options-considered-engine","content":"Yes"},"111":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-37","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#options-considered-engine","content":"None"},"112":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-38","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#options-considered-engine","content":"MIT"},"113":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-39","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#options-considered-engine","content":"Too low-level — every text run becomes a hand-written content stream"},"114":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-40","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#options-considered-engine","content":"D. `pdfium-render` (write)"},"115":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-41","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#options-considered-engine","content":"No"},"116":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-42","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#options-considered-engine","content":"Via pdfium"},"117":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-43","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#options-considered-engine","content":"No"},"118":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-44","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#options-considered-engine","content":"libpdfium"},"119":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-45","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#options-considered-engine","content":"Apache"},"120":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-46","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#options-considered-engine","content":"Ships a 30+ MB native lib; overkill for write-only"},"121":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-47","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#options-considered-engine","content":"E. `weasyprint` / HTML→PDF"},"122":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-48","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#options-considered-engine","content":"No"},"123":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-49","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#options-considered-engine","content":"Yes"},"124":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-50","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#options-considered-engine","content":"Probabilistic CSS layout"},"125":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-51","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#options-considered-engine","content":"Python + Cairo + Pango"},"126":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-52","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#options-considered-engine","content":"LGPL"},"127":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-53","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#options-considered-engine","content":"Hostile to a Tauri sidecar and to determinism"},"128":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-54","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#engine","content":"Rationale (priority order):"},"129":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-55","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#engine","content":"**Pure Rust, no system deps.** `shalgalt-pdf` builds on every target the workspace\nalready supports without adding the OpenCV-style Windows install dance. This was the\nsingle biggest factor."},"130":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-56","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#engine","content":"**Deterministic output.** `PdfDocument::new` defaults the `creation_date` /\n`modification_date` to the unix epoch. The trailer's `/ID` array is randomized per\nrun, but is straightforward to strip in golden-file comparisons (see\n`tests/golden.rs::normalize_pdf`). This makes the renderer suitable for the\ngolden-file regression workflow that lands in P2-12."},"131":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-57","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#engine","content":"**TTF embedding + auto-subsetting.** `PdfSaveOptions { subset_fonts: true, .. }`\nkeeps the output reasonable when only a small Cyrillic / Mongolian-script glyph set\nis actually drawn."},"132":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-58","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#engine","content":"**No higher-level layout engine.** The renderer is data-driven from `OmrTemplate`,\nwhich already encodes every coordinate. A library that re-imposes its own flow\nlayout (genpdf, weasyprint) just gets in the way."},"133":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-59","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#bubble-geometry-locked-for-p3-01--p3-02","content":"Property"},"134":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-60","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#bubble-geometry-locked-for-p3-01--p3-02","content":"Value"},"135":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-61","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#bubble-geometry-locked-for-p3-01--p3-02","content":"Bubble diameter"},"136":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-62","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#bubble-geometry-locked-for-p3-01--p3-02","content":"**2.5 mm**"},"137":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-63","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#bubble-geometry-locked-for-p3-01--p3-02","content":"Stroke width"},"138":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-64","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#bubble-geometry-locked-for-p3-01--p3-02","content":"**0.4 mm**"},"139":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-65","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#bubble-geometry-locked-for-p3-01--p3-02","content":"Center-to-center pitch (multiple choice)"},"140":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-66","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#bubble-geometry-locked-for-p3-01--p3-02","content":"**6.0 mm**"},"141":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-67","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#bubble-geometry-locked-for-p3-01--p3-02","content":"Center-to-center pitch (numeric digit row)"},"142":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-68","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#bubble-geometry-locked-for-p3-01--p3-02","content":"**5.4 mm**"},"143":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-69","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#bubble-geometry-locked-for-p3-01--p3-02","content":"Label offset (right of bubble)"},"144":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-70","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#bubble-geometry-locked-for-p3-01--p3-02","content":"**1.5 mm**"},"145":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-71","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#bubble-geometry-locked-for-p3-01--p3-02","content":"Label font size"},"146":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-72","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#bubble-geometry-locked-for-p3-01--p3-02","content":"**8 pt** Noto Sans Regular"},"147":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-73","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#bubble-geometry-locked-for-p3-01--p3-02","content":"Marker side length"},"148":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-74","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#bubble-geometry-locked-for-p3-01--p3-02","content":"**`size * min(width, height)` mm** (template-driven; default `size = 0.02` → \\~4.2 mm on A4)"},"149":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-75","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#bubble-geometry-locked-for-p3-01--p3-02","content":"These match the defaults in `BubbleStyle::default()` (`crates/shalgalt-pdf/src/style.rs`).\nThe pitch values are emergent from the Mongolian-standard preset\n(`src/lib/templates/mongolianStandard.ts`); changing the preset coordinates in either\nlanguage without updating the other will be caught by the golden-file test."},"150":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-76","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#determinism-contract","content":"The renderer never reads wall-clock time on its own."},"151":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-77","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#determinism-contract","content":"Callers may override `PdfOptions::created_at`. The default is `None`, in which case\n`printpdf`'s epoch default is used."},"152":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-78","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#determinism-contract","content":"Every other source of randomness (`/ID`) is stripped in golden comparisons. Production\nbuilds keep the random `/ID` for PDF-spec compliance."},"153":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-79","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#consequences","content":"**CV team contract.** P3-01 / P3-02 may assume the values above when designing blob\ndetector parameters and template-fit tolerances. Any future change to the geometry\nrequires a new ADR and a corresponding update to the golden file (regenerated via\n`cargo test -p shalgalt-pdf --test golden -- --ignored regenerate_golden`)."},"154":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-80","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#consequences","content":"**printpdf 0.9 → 0.10 migration.** The `Op` enum and `ParsedFont::from_bytes`\nsignatures changed between 0.7 → 0.8 → 0.9. Pin minor versions; revisit with an ADR\nfollow-up before bumping past 0.9.x."},"155":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-81","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#consequences","content":"**Mongolian script.** `NotoSansMongolian-Regular.ttf` is embedded only when the\ncaller passes `instructions: Some(_)`. Vertical script rendering uses\n`Op::SetTextMatrix(TextMatrix::TranslateRotate(x, y, 90.0))` — `printpdf`'s `Tm`\noperator path. Real shaping (joining contextual forms) is out of scope; if the\nMongolian sidebar reads poorly in production we revisit with `harfbuzz_rs`."},"156":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-82","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#consequences","content":"**Future ArUco markers.** `MarkerKind::Aruco6x6` is currently rendered as a solid\nsquare placeholder. Bitmap stamping ships with the CV migration in P3-01."},"157":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-83","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#follow-up","content":"P2-12 — record this ADR alongside the rest of the P2 ADR set."},"158":{"id":"/mn/docs/adr/0002-pdf-generator-printpdf-84","page_id":"/mn/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/mn/docs/adr/0002-pdf-generator-printpdf#follow-up","content":"P3-01 — document the CV-side acceptance numbers (blob radius window, threshold\nparameters) that were calibrated against the geometry above."},"159":{"id":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries","page_id":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries","type":"page","content":"ADR 0003 — Cargo workspace & crate boundaries","breadcrumbs":["Docs","Architecture Decisions"],"tags":[],"url":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries"},"160":{"id":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries-0","page_id":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries","tags":[],"type":"text","url":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries","content":"Split the single P0 crate into a Cargo workspace of app hosts and pure library crates so the grading core is reusable without Tauri."},"161":{"id":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries-1","page_id":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries","type":"heading","tags":[],"url":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries#context","content":"Context"},"162":{"id":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries-2","page_id":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries","type":"heading","tags":[],"url":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries#options-considered","content":"Options considered"},"163":{"id":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries-3","page_id":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries","type":"heading","tags":[],"url":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries#decision","content":"Decision"},"164":{"id":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries-4","page_id":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries","type":"heading","tags":[],"url":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries#consequences","content":"Consequences"},"165":{"id":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries-5","page_id":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries","type":"heading","tags":[],"url":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries#follow-up","content":"Follow-up"},"166":{"id":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries-6","page_id":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries","tags":[],"type":"text","url":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries#context","content":"P0 shipped the entire Rust backend in a single crate at `src-tauri/`. The grading\ncore, the CV pipeline, and the Tauri shell all lived in the same dependency graph,\nso `apps/server` (master plan §15, P5-05) — a headless build of the same grading\ncore for batch jobs — would either drag a `tauri` dependency into a daemon binary\nor duplicate the domain types. Neither is acceptable."},"167":{"id":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries-7","page_id":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries","tags":[],"type":"text","url":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries#options-considered","content":"Option"},"168":{"id":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries-8","page_id":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries","tags":[],"type":"text","url":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries#options-considered","content":"Reusable core"},"169":{"id":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries-9","page_id":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries","tags":[],"type":"text","url":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries#options-considered","content":"Build cost"},"170":{"id":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries-10","page_id":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries","tags":[],"type":"text","url":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries#options-considered","content":"Surface area to refactor"},"171":{"id":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries-11","page_id":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries","tags":[],"type":"text","url":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries#options-considered","content":"Stay single-crate, add a `headless` feature flag"},"172":{"id":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries-12","page_id":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries","tags":[],"type":"text","url":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries#options-considered","content":"Partial — `tauri` types still on the path via macros"},"173":{"id":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries-13","page_id":"/mn/docs/adr/0003-cargo-workspace-and-crate-boundaries","tags":[],"type":"text","url":"/mn/docs/adr/0003-cargo-workspace-and