gs":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#options-considered","content":"DLL size"},"19":{"id":"/en/docs/adr/0001-windows-opencv-strategy-17","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#options-considered","content":"Module selectivity"},"20":{"id":"/en/docs/adr/0001-windows-opencv-strategy-18","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#options-considered","content":"A. vcpkg manifest"},"21":{"id":"/en/docs/adr/0001-windows-opencv-strategy-19","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#options-considered","content":"30–60 min"},"22":{"id":"/en/docs/adr/0001-windows-opencv-strategy-20","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#options-considered","content":"2–5 min"},"23":{"id":"/en/docs/adr/0001-windows-opencv-strategy-21","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#options-considered","content":"30–60 min"},"24":{"id":"/en/docs/adr/0001-windows-opencv-strategy-22","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#options-considered","content":"6–15 MB"},"25":{"id":"/en/docs/adr/0001-windows-opencv-strategy-23","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#options-considered","content":"Yes"},"26":{"id":"/en/docs/adr/0001-windows-opencv-strategy-24","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#options-considered","content":"**B. Prebuilt opencv.exe**"},"27":{"id":"/en/docs/adr/0001-windows-opencv-strategy-25","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#options-considered","content":"**5–10 min**"},"28":{"id":"/en/docs/adr/0001-windows-opencv-strategy-26","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#options-considered","content":"**2–3 min**"},"29":{"id":"/en/docs/adr/0001-windows-opencv-strategy-27","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#options-considered","content":"**5–10 min**"},"30":{"id":"/en/docs/adr/0001-windows-opencv-strategy-28","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#options-considered","content":"\\~70 MB (`opencv_world`)"},"31":{"id":"/en/docs/adr/0001-windows-opencv-strategy-29","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#options-considered","content":"No"},"32":{"id":"/en/docs/adr/0001-windows-opencv-strategy-30","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#options-considered","content":"C. Chocolatey (`choco install opencv`)"},"33":{"id":"/en/docs/adr/0001-windows-opencv-strategy-31","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#options-considered","content":"2–5 min"},"34":{"id":"/en/docs/adr/0001-windows-opencv-strategy-32","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#options-considered","content":"2–5 min"},"35":{"id":"/en/docs/adr/0001-windows-opencv-strategy-33","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#options-considered","content":"2–5 min"},"36":{"id":"/en/docs/adr/0001-windows-opencv-strategy-34","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#options-considered","content":"\\~70 MB"},"37":{"id":"/en/docs/adr/0001-windows-opencv-strategy-35","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#options-considered","content":"No"},"38":{"id":"/en/docs/adr/0001-windows-opencv-strategy-36","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#options-considered","content":"D. LFS-vendored binaries"},"39":{"id":"/en/docs/adr/0001-windows-opencv-strategy-37","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#options-considered","content":"\\<2 min"},"40":{"id":"/en/docs/adr/0001-windows-opencv-strategy-38","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#options-considered","content":"\\<2 min"},"41":{"id":"/en/docs/adr/0001-windows-opencv-strategy-39","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#options-considered","content":"LFS pull"},"42":{"id":"/en/docs/adr/0001-windows-opencv-strategy-40","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#options-considered","content":"Our choice"},"43":{"id":"/en/docs/adr/0001-windows-opencv-strategy-41","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#options-considered","content":"If we pre-build"},"44":{"id":"/en/docs/adr/0001-windows-opencv-strategy-42","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#options-considered","content":"(See conversation log dated 2026-05-02 for detailed pros/cons of each option.)"},"45":{"id":"/en/docs/adr/0001-windows-opencv-strategy-43","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#decision","content":"Rationale, in priority order:"},"46":{"id":"/en/docs/adr/0001-windows-opencv-strategy-44","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#decision","content":"**CI economy**. Windows GitHub Actions runners cost 2× Linux. A 5–10 min build keeps\nper-commit Windows CI affordable; vcpkg's 30–60 min cold builds would dominate the\npipeline budget and discourage developers from triggering manual builds."},"47":{"id":"/en/docs/adr/0001-windows-opencv-strategy-45","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#decision","content":"**Local dev parity**. The same five-minute install procedure works on a fresh dev\nmachine. Anything more complicated (vcpkg, custom toolchain) raises the on-ramp for\ncontributors."},"48":{"id":"/en/docs/adr/0001-windows-opencv-strategy-46","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#decision","content":"**OpenCV usage is module-light**. shalgalt-omr only calls `core`, `imgproc`,\n`imgcodecs`, and `calib3d`. The 70 MB cost of `opencv_world` is real but bounded —\nit is the difference between a 80 MB and a 20 MB installer, both of which are\nacceptable for USB / school-network distribution at P0–P4. We are not optimising\nfor App Store size limits."},"49":{"id":"/en/docs/adr/0001-windows-opencv-strategy-47","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#decision","content":"**Reversibility**. A → B is hard (you would have to commit to vcpkg manifests, NuGet\nbinary cache, and a different CI shape). B → A is easy: you replace the install\nstep, set the same three env vars to vcpkg paths, drop `opencv_world` for individual\n`opencv_core` / `opencv_imgproc` libs. We can always migrate later when DLL diet\nbecomes a real constraint."},"50":{"id":"/en/docs/adr/0001-windows-opencv-strategy-48","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#pinned-version","content":"OpenCV **4.10.0**. Bumping requires updating both:"},"51":{"id":"/en/docs/adr/0001-windows-opencv-strategy-49","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#pinned-version","content":"`.github/workflows/ci.yml` — the `OPENCV_VERSION`\njob-level env var (drives the download URL and the `opencv_world<NNN>` DLL name)."},"52":{"id":"/en/docs/adr/0001-windows-opencv-strategy-50","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#pinned-version","content":"`README.md` — the Windows install snippet."},"53":{"id":"/en/docs/adr/0001-windows-opencv-strategy-51","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#pinned-version","content":"The shortened DLL name follows OpenCV's convention: dots stripped, no padding. So\n`4.10.0` → `opencv_world4100.dll`, `4.5.5` → `opencv_world455.dll`."},"54":{"id":"/en/docs/adr/0001-windows-opencv-strategy-52","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#required-env-vars","content":"opencv-rust auto-discovers OpenCV on Windows when these three are set:"},"55":{"id":"/en/docs/adr/0001-windows-opencv-strategy-53","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#required-env-vars","content":"Variable"},"56":{"id":"/en/docs/adr/0001-windows-opencv-strategy-54","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#required-env-vars","content":"Value"},"57":{"id":"/en/docs/adr/0001-windows-opencv-strategy-55","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#required-env-vars","content":"`OPENCV_LINK_LIBS`"},"58":{"id":"/en/docs/adr/0001-windows-opencv-strategy-56","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#required-env-vars","content":"`opencv_world<NNN>` (e.g. `opencv_world4100`)"},"59":{"id":"/en/docs/adr/0001-windows-opencv-strategy-57","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#required-env-vars","content":"`OPENCV_LINK_PATHS`"},"60":{"id":"/en/docs/adr/0001-windows-opencv-strategy-58","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#required-env-vars","content":"`C:\\tools\\opencv\\build\\x64\\vc16\\lib`"},"61":{"id":"/en/docs/adr/0001-windows-opencv-strategy-59","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#required-env-vars","content":"`OPENCV_INCLUDE_PATHS`"},"62":{"id":"/en/docs/adr/0001-windows-opencv-strategy-60","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#required-env-vars","content":"`C:\\tools\\opencv\\build\\include`"},"63":{"id":"/en/docs/adr/0001-windows-opencv-strategy-61","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#required-env-vars","content":"Plus `LIBCLANG_PATH=C:\\Program Files\\LLVM\\bin` for bindgen, and the `bin` directory must\nbe on `PATH` so the runtime DLL is resolvable when launching the produced `.exe`."},"64":{"id":"/en/docs/adr/0001-windows-opencv-strategy-62","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#required-env-vars","content":"`vc16` corresponds to the MSVC v142 toolchain (Visual Studio 2019). It is\nforward-compatible with VS 2022's MSVC v143 — windows-latest GitHub runners use VS 2022\nbut link successfully against the vc16 OpenCV libs."},"65":{"id":"/en/docs/adr/0001-windows-opencv-strategy-63","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#positive","content":"Windows CI matrix activates with \\~5 min install + \\~15 min build."},"66":{"id":"/en/docs/adr/0001-windows-opencv-strategy-64","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#positive","content":"Local Windows dev follows the same procedure as CI — copy/paste the env vars,\ndownload once, build."},"67":{"id":"/en/docs/adr/0001-windows-opencv-strategy-65","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#positive","content":"No vcpkg learning curve for contributors."},"68":{"id":"/en/docs/adr/0001-windows-opencv-strategy-66","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#negative","content":"Installer size carries the full 70 MB `opencv_world<NNN>.dll` even though we use \\~4\nmodules. P5 packaging may revisit."},"69":{"id":"/en/docs/adr/0001-windows-opencv-strategy-67","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#negative","content":"Bound to opencv.org's GitHub Releases URL format. If upstream stops shipping\n`opencv-X.Y.Z-windows.exe`, we migrate to A or D."},"70":{"id":"/en/docs/adr/0001-windows-opencv-strategy-68","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#negative","content":"`opencv_world` lacks debug symbols. Diagnosing native crashes inside OpenCV on\nWindows is harder than on Linux's `libopencv-dev` (which has separate `-dbg`\npackages). Acceptable trade-off for now."},"71":{"id":"/en/docs/adr/0001-windows-opencv-strategy-69","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#follow-up-tickets","content":"**P5 — installer diet**. Re-evaluate vcpkg with feature-selective build if Windows\ninstaller footprint becomes a complaint vector. Target: \\< 30 MB total."},"72":{"id":"/en/docs/adr/0001-windows-opencv-strategy-70","page_id":"/en/docs/adr/0001-windows-opencv-strategy","tags":[],"type":"text","url":"/en/docs/adr/0001-windows-opencv-strategy#follow-up-tickets","content":"**pdfium bundling** is orthogonal and tracked separately (see README \"pdfium\")."},"73":{"id":"/en/docs/adr/0002-pdf-generator-printpdf","page_id":"/en/docs/adr/0002-pdf-generator-printpdf","type":"page","content":"ADR 0002 — PDF generator: printpdf","breadcrumbs":["Docs","Architecture Decisions"],"tags":[],"url":"/en/docs/adr/0002-pdf-generator-printpdf"},"74":{"id":"/en/docs/adr/0002-pdf-generator-printpdf-0","page_id":"/en/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/en/docs/adr/0002-pdf-generator-printpdf","content":"Adopt the pure-Rust printpdf engine with embedded Noto fonts and lock the OMR bubble geometry the CV pipeline depends on."},"75":{"id":"/en/docs/adr/0002-pdf-generator-printpdf-1","page_id":"/en/docs/adr/0002-pdf-generator-printpdf","type":"heading","tags":[],"url":"/en/docs/adr/0002-pdf-generator-printpdf#context","content":"Context"},"76":{"id":"/en/docs/adr/0002-pdf-generator-printpdf-2","page_id":"/en/docs/adr/0002-pdf-generator-printpdf","type":"heading","tags":[],"url":"/en/docs/adr/0002-pdf-generator-printpdf#options-considered-engine","content":"Options considered (engine)"},"77":{"id":"/en/docs/adr/0002-pdf-generator-printpdf-3","page_id":"/en/docs/adr/0002-pdf-generator-printpdf","type":"heading","tags":[],"url":"/en/docs/adr/0002-pdf-generator-printpdf#decision","content":"Decision"},"78":{"id":"/en/docs/adr/0002-pdf-generator-printpdf-4","page_id":"/en/docs/adr/0002-pdf-generator-printpdf","type":"heading","tags":[],"url":"/en/docs/adr/0002-pdf-generator-printpdf#engine","content":"Engine"},"79":{"id":"/en/docs/adr/0002-pdf-generator-printpdf-5","page_id":"/en/docs/adr/0002-pdf-generator-printpdf","type":"heading","tags":[],"url":"/en/docs/adr/0002-pdf-generator-printpdf#bubble-geometry-locked-for-p3-01--p3-02","content":"Bubble geometry (locked for P3-01 / P3-02)"},"80":{"id":"/en/docs/adr/0002-pdf-generator-printpdf-6","page_id":"/en/docs/adr/0002-pdf-generator-printpdf","type":"heading","tags":[],"url":"/en/docs/adr/0002-pdf-generator-printpdf#determinism-contract","content":"Determinism contract"},"81":{"id":"/en/docs/adr/0002-pdf-generator-printpdf-7","page_id":"/en/docs/adr/0002-pdf-generator-printpdf","type":"heading","tags":[],"url":"/en/docs/adr/0002-pdf-generator-printpdf#consequences","content":"Consequences"},"82":{"id":"/en/docs/adr/0002-pdf-generator-printpdf-8","page_id":"/en/docs/adr/0002-pdf-generator-printpdf","type":"heading","tags":[],"url":"/en/docs/adr/0002-pdf-generator-printpdf#follow-up","content":"Follow-up"},"83":{"id":"/en/docs/adr/0002-pdf-generator-printpdf-9","page_id":"/en/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/en/docs/adr/0002-pdf-generator-printpdf#context","content":"P2-05 brought the `shalgalt-pdf` crate online, P2-06 turns it into a real OMR card\nrenderer (markers, header, multiple-choice grid, numeric blocks, Mongolian-script\nsidebar). Two coupled decisions land here so P3 (CV pipeline) does not re-litigate them:"},"84":{"id":"/en/docs/adr/0002-pdf-generator-printpdf-10","page_id":"/en/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/en/docs/adr/0002-pdf-generator-printpdf#context","content":"**PDF engine choice** — what library writes the PDF bytes, and what determinism /\nfont / dependency budget we commit to."},"85":{"id":"/en/docs/adr/0002-pdf-generator-printpdf-11","page_id":"/en/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/en/docs/adr/0002-pdf-generator-printpdf#context","content":"**OMR bubble geometry** — physical diameter, stroke width, and pitch of every printed\nbubble. The CV pipeline (P3-01 / P3-02) hard-codes these into its blob detector and\nadaptive threshold parameters, so a renderer that chooses a different value would\nsilently degrade grading accuracy."},"86":{"id":"/en/docs/adr/0002-pdf-generator-printpdf-12","page_id":"/en/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/en/docs/adr/0002-pdf-generator-printpdf#options-considered-engine","content":"Option"},"87":{"id":"/en/docs/adr/0002-pdf-generator-printpdf-13","page_id":"/en/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/en/docs/adr/0002-pdf-generator-printpdf#options-considered-engine","content":"Pure Rust"},"88":{"id":"/en/docs/adr/0002-pdf-generator-printpdf-14","page_id":"/en/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/en/docs/adr/0002-pdf-generator-printpdf#options-considered-engine","content":"Embed TTF"},"89":{"id":"/en/docs/adr/0002-pdf-generator-printpdf-15","page_id":"/en/docs/adr/0002-pdf-generator-printpdf","tags":[],"type":"text","url":"/en/docs/adr/0002-pdf-generator-printpdf#options-considered-engine","content":"Determinism"},"90":{"id":"/en/docs/adr/0002-pdf-generator-printpdf-16","page_id":"/en/docs/adr/0002-