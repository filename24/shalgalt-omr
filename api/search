workspace","tags":[],"type":"text","url":"/en/docs/dev/workspace#crate-responsibilities","content":"pdfium rasterization + OpenCV detection + confidence scoring"},"1208":{"id":"/en/docs/dev/workspace-13","page_id":"/en/docs/dev/workspace","tags":[],"type":"text","url":"/en/docs/dev/workspace#crate-responsibilities","content":"Tauri, the axum router"},"1209":{"id":"/en/docs/dev/workspace-14","page_id":"/en/docs/dev/workspace","tags":[],"type":"text","url":"/en/docs/dev/workspace#crate-responsibilities","content":"`shalgalt-pdf`"},"1210":{"id":"/en/docs/dev/workspace-15","page_id":"/en/docs/dev/workspace","tags":[],"type":"text","url":"/en/docs/dev/workspace#crate-responsibilities","content":"printpdf rendering of a template to a printable sheet"},"1211":{"id":"/en/docs/dev/workspace-16","page_id":"/en/docs/dev/workspace","tags":[],"type":"text","url":"/en/docs/dev/workspace#crate-responsibilities","content":"Tauri, OpenCV"},"1212":{"id":"/en/docs/dev/workspace-17","page_id":"/en/docs/dev/workspace","tags":[],"type":"text","url":"/en/docs/dev/workspace#crate-responsibilities","content":"`shalgalt-fileformat`"},"1213":{"id":"/en/docs/dev/workspace-18","page_id":"/en/docs/dev/workspace","tags":[],"type":"text","url":"/en/docs/dev/workspace#crate-responsibilities","content":"Streaming `.shalgalt` read/write, age crypto wrapper"},"1214":{"id":"/en/docs/dev/workspace-19","page_id":"/en/docs/dev/workspace","tags":[],"type":"text","url":"/en/docs/dev/workspace#crate-responsibilities","content":"The `OmrTemplate` struct (lives in core), Tauri"},"1215":{"id":"/en/docs/dev/workspace-20","page_id":"/en/docs/dev/workspace","tags":[],"type":"text","url":"/en/docs/dev/workspace#crate-responsibilities","content":"`shalgalt-store`"},"1216":{"id":"/en/docs/dev/workspace-21","page_id":"/en/docs/dev/workspace","tags":[],"type":"text","url":"/en/docs/dev/workspace#crate-responsibilities","content":"`rusqlite` `DataStore` impl for the server"},"1217":{"id":"/en/docs/dev/workspace-22","pag