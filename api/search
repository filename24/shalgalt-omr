ckage."},"1225":{"id":"/mn/docs/dev/workspace-30","page_id":"/mn/docs/dev/workspace","tags":[],"type":"text","url":"/mn/docs/dev/workspace#type-generation-ts-rs","content":"Domain models that cross the IPC boundary derive `ts_rs::TS` and export TypeScript\ninterfaces into `src/lib/types/generated/` when `cargo test -p shalgalt-core` runs. The\nfrontend script `pnpm generate-types` wraps the same command. A drift between the Rust struct\nand the generated TS fails `pnpm check` in CI — this is the mechanical enforcement of\nRule 3."},"1226":{"id":"/mn/docs/user/editor","page_id":"/mn/docs/user/editor","type":"page","content":"Загвар засварлагч","breadcrumbs":["Docs","Хэрэглэгчийн гарын авлага","Боломжууд"],"tags":[],"url":"/mn/docs/user/editor"},"1227":{"id":"/mn/docs/user/editor-0","page_id":"/mn/docs/user/editor","tags":[],"type":"text","url":"/mn/docs/user/editor","content":"Хариултын хуудасны загварыг визуал засварлагчид зохиох."},"1228":{"id":"/mn/docs/user/editor-1","page_id":"/mn/docs/user/editor","type":"heading","tags":[],"url":"/mn/docs/user/editor#үндсэн-алхмууд","content":"Үндсэн алхмууд"},"1229":{"id":"/mn/docs/user/editor-2","page_id":"/mn/docs/user/editor","type":"heading","tags":[],"url":"/mn/docs/user/editor#засварлагчийг-нээх","content":"Засварлагчийг нээх"},"1230":{"id":"/mn/docs/user/editor-3","page_id":"/mn/docs/user/editor","type":"heading","tags":[],"url":"/mn/docs/user/editor#дэвсгэр-зураг-импортлох","content":"Дэвсгэр зураг импортлох"},"1231":{"id":"/mn/docs/user/editor-4","page_id":"/mn/docs/user/editor","type":"heading","tags":[],"url":"/mn/docs/user/editor#бөмбөлгийн-бүлэг-нэмэх","content":"Бөмбөлгийн бүлэг нэмэх"},"1232":{"id":"/mn/docs/user/editor-5","page_id":"/mn/docs/user/editor","type":"heading","tags":[],"url":"/mn/docs/user/editor#хадгалах","content":"Хадгалах"},"1233":{"id":"/mn/docs/user/editor-6","page_id":"/mn/docs/user/editor","type":"heading","tags":[],"url":"/mn/docs/user/editor#pdf-болгон-гаргах","content":"PDF болгон гаргах